{
  "name": "wormbrain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server/server.mjs",
    "test": "node server/test.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "desktop:dev": "electron .",
    "desktop:build": "npm run web:build && electron-builder --publish never",
    "content": "electron konten-spoor/_src/render.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "ethers": "^6.13.0",
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "main": "desktop/main.mjs",
  "description": "Spoor: a paper trader whose brain is the 302-neuron C. elegans connectome, on Robinhood Chain",
  "author": "Spoor",
  "build": {
    "appId": "com.wormbrain.desktop",
    "productName": "Spoor",
    "asar": false,
    "directories": {
      "output": "dist-desktop",
      "buildResources": "desktop/build"
    },
    "files": [
      "package.json",
      "desktop/main.mjs",
      "desktop/build/icon.png",
      "server/**/*",
      "!server/test.mjs",
      "data/assets.json",
      "data/connectome.json",
      "site/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Spoor-${version}-${os}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Spoor-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Spoor-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "Spoor-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Finance",
      "artifactName": "Spoor-${version}-linux-${arch}.${ext}",
      "maintainer": "Spoor"
    }
  }
}
